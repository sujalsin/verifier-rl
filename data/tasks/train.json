  {
    "task_id": "str_is_anagram",
    "category": "string",
    "prompt": "def is_anagram(s1: str, s2: str) -> bool:\n    \"\"\"Return True if s1 and s2 are anagrams (ignoring spaces and case), False otherwise.\"\"\"\n",
    "entry_point": "is_anagram",
    "train_tests": [
      {"args": ["listen", "silent"], "expected": true, "is_trivial": true},
      {"args": ["hello", "world"], "expected": false, "is_trivial": true},
      {"args": ["Astronomer", "Moon starer"], "expected": true, "is_trivial": false},
      {"args": ["", ""], "expected": true, "is_trivial": false}
    ],
    "hidden_tests": [
      {"args": ["rat", "car"], "expected": false},
      {"args": ["Debit Card", "Bad Credit"], "expected": true},
      {"args": ["a", "ab"], "expected": false},
      {"args": ["Dormitory", "Dirty Room"], "expected": true}
    ]
  },
  {
