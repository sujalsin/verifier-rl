[
  {
    "task_id": "math_sum_even",
    "category": "math",
    "prompt": "def sum_even(arr: list[int]) -> int:\n    \"\"\"Return the sum of all even numbers in arr.\"\"\"\n",
    "entry_point": "sum_even",
    "train_tests": [
      {"args": [[1, 2, 3, 4]], "expected": 6, "is_trivial": true},
      {"args": [[2, 4, 6]], "expected": 12, "is_trivial": true},
      {"args": [[-2, -4, 1]], "expected": -6, "is_trivial": false},
      {"args": [[]], "expected": 0, "is_trivial": false}
    ],
    "hidden_tests": [
      {"args": [[1, 3, 5, 7]], "expected": 0},
      {"args": [[0, 0, 0]], "expected": 0},
      {"args": [[-10, 10, -20, 20]], "expected": 0},
      {"args": [[100, 200, 301]], "expected": 300}
    ]
  },
  {
    "task_id": "math_is_prime",
