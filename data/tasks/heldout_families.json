    "prompt": "def merge_intervals(intervals: list[list[int]]) -> list[list[int]]:\n    \"\"\"Merge all overlapping intervals [start, end]. Intervals are sorted by start before merging.\"\"\"\n",
    "entry_point": "merge_intervals",
