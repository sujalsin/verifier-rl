      {"args": [[]], "expected": [], "is_trivial": false}
    ],
    "hidden_tests": [
      {"args": [[[1]]], "expected": [[1]]},
      {"args": [[[1, 2, 3]]], "expected": [[1], [2], [3]]},
      {"args": [[[1], [2], [3]]], "expected": [[1, 2, 3]]}
    ]
  },
