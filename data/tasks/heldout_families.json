      {"args": [[]], "expected": [], "is_trivial": false}
    ],
    "hidden_tests": [
      {"args": [[[1, 4], [0, 4]]], "expected": [[0, 4]]},
      {"args": [[[1, 4], [2, 3]]], "expected": [[1, 4]]},
      {"args": [[[1, 2]]], "expected": [[1, 2]]}
    ]
  },
  {
